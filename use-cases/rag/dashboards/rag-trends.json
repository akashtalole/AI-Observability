{
 "uid": "rag-trends",
 "title": "RAG - Trends (weeks to months)",
 "tags": [
  "ai-observability",
  "rag",
  "use-case",
  "trends"
 ],
 "description": "Month-over-month view built on recording rules. Set the time range to 30d / 90d / 6M. Prometheus keeps 90d by default; use Mimir/Thanos/VictoriaMetrics (or the ClickHouse rollups from the handbook) for 6-18 months.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Change events",
    "enable": true,
    "iconColor": "orange",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{service_name=\"support-rag\"} |= \"scenario change\"",
    "titleFormat": "change",
    "textFormat": "{{detected_level}}"
   }
  ]
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "id": 1,
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "**Long-range view.** Panels read daily recording rules (`rag:*:_1d`) so they stay fast over months. Retention is the limit: extend with Mimir/Thanos/VictoriaMetrics or serve this dashboard from the ClickHouse wide-fact rollups ([storage guide](https://akashtalole.github.io/ai-observability/architecture/storage-and-retention/)). Overlay change events (deploys, prompt, model, index) to explain every shift."
   }
  },
  {
   "type": "timeseries",
   "title": "p95 latency (daily)",
   "id": 2,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rag:latency_seconds:p95_1d",
     "legendFormat": "p95",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Cost per request (daily)",
   "id": 3,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rag:cost_per_request_usd:ratio_1d",
     "legendFormat": "USD / request",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "min": 0,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Groundedness (daily mean)",
   "id": 4,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rag:groundedness:mean_1d",
     "legendFormat": "groundedness",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "max": 1,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Week-over-week change",
   "id": 5,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rag:latency_seconds:p95_1d / (rag:latency_seconds:p95_1d offset 7d) - 1",
     "legendFormat": "p95 latency",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rag:cost_per_request_usd:ratio_1d / (rag:cost_per_request_usd:ratio_1d offset 7d) - 1",
     "legendFormat": "cost / request",
     "range": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rag:groundedness:mean_1d / (rag:groundedness:mean_1d offset 7d) - 1",
     "legendFormat": "groundedness",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": null,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Daily request volume & spend",
   "id": 6,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(rag_requests_total{service_name=\"support-rag\"}[1d]))",
     "legendFormat": "requests / day",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(rag_cost_usd_total{service_name=\"support-rag\"}[1d])) * 1000",
     "legendFormat": "spend x1000 USD / day",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": null,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ],
 "links": [
  {
   "title": "Handbook",
   "type": "link",
   "url": "https://akashtalole.github.io/ai-observability/",
   "targetBlank": true
  }
 ]
}
