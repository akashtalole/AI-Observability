{
 "uid": "omni-session-explorer",
 "title": "Omni-style \u00b7 Session Explorer",
 "tags": [
  "ai-observability",
  "omni-style"
 ],
 "description": "Multi-turn conversations: recent sessions, the turns of one session, and conversation-level health.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(traces_span_metrics_calls_total, service_name)",
     "refId": "v"
    }
   },
   {
    "name": "session",
    "label": "session / conversation ID",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   },
   {
    "name": "traceId",
    "label": "trace ID",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "id": 1,
   "gridPos": {
    "h": 2,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "Sessions are identified by `gen_ai.conversation.id`. Click a session in the table to see all of its turns; click a turn's trace to open the timeline."
   }
  },
  {
   "type": "row",
   "title": "Conversation health (chatbot)",
   "id": 2,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 2
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Conversations",
   "id": 3,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(chat_sessions_total{service_name=\"support-chatbot\"}[$__range]))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Containment",
   "id": 4,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(chat_sessions_total{service_name=\"support-chatbot\",outcome=\"resolved\"}[$__range]))) / (sum(increase(chat_sessions_total{service_name=\"support-chatbot\"}[$__range])))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.6
       },
       {
        "color": "green",
        "value": 0.75
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Escalated",
   "id": 5,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(chat_sessions_total{service_name=\"support-chatbot\",outcome=\"escalated\"}[$__range]))) / (sum(increase(chat_sessions_total{service_name=\"support-chatbot\"}[$__range])))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Abandoned",
   "id": 6,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(((sum(increase(chat_sessions_total{service_name=\"support-chatbot\",outcome=\"abandoned\"}[$__range]))) or vector(0))) / (sum(increase(chat_sessions_total{service_name=\"support-chatbot\"}[$__range])))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Turns / conversation p95",
   "id": 7,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (increase(chat_session_turns_bucket{service_name=\"support-chatbot\"}[$__range])))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Cost / conversation",
   "id": 8,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(chat_cost_usd_total{service_name=\"support-chatbot\"}[$__range]))) / (sum(increase(chat_sessions_total{service_name=\"support-chatbot\"}[$__range])))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Conversations by outcome",
   "id": 9,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (rate(chat_sessions_total{service_name=\"support-chatbot\"}[$__rate_interval]))",
     "legendFormat": "{{outcome}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": null,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 30,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Turns per conversation p50 / p95",
   "id": 10,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(chat_session_turns_bucket{service_name=\"support-chatbot\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(chat_session_turns_bucket{service_name=\"support-chatbot\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Active conversations",
   "id": 11,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(chat_active_sessions{service_name=\"support-chatbot\"})",
     "legendFormat": "active",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Browse sessions",
   "id": 12,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Recent sessions (turn spans)",
   "id": 13,
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "Each row is a turn/request. Copy a conversation ID into the *session* variable.",
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ span.gen_ai.conversation.id != \"\" && resource.service.name =~ \"$service\" } | select(span.gen_ai.conversation.id, span.app.intent, span.app.feature)",
     "limit": 20,
     "tableType": "spans"
    }
   ],
   "options": {
    "showHeader": true
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "row",
   "title": "Selected session",
   "id": 14,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Turns of session $session",
   "id": 15,
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ span.gen_ai.conversation.id = \"$session\" } | select(span.app.intent, span.app.turn.index, span.cost.usd.total)",
     "limit": 20,
     "tableType": "spans"
    }
   ],
   "options": {
    "showHeader": true
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "traces",
   "title": "Trace timeline for $traceId",
   "id": 16,
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "Set the traceId variable at the top (paste a traceID from the table)",
   "gridPos": {
    "h": 14,
    "w": 24,
    "x": 0,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "$traceId"
    }
   ]
  }
 ],
