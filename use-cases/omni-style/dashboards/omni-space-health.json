{
 "uid": "omni-space-health",
 "title": "Omni-style \u00b7 Space health & SLOs",
 "tags": [
  "ai-observability",
  "omni-style"
 ],
 "description": "A team's 'Space': every application it owns with SLO attainment, burn rate, error budget, active alerts, dependencies and change events.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(traces_span_metrics_calls_total, service_name)",
     "refId": "v"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "SLOs per application (selected range)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Application SLO scorecard",
   "id": 2,
   "description": "Budget left = 1 - (error ratio / 0.5%) over the selected range; below 0 means the SLO is breached",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - (((sum by (service_name) (increase(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__range]))) or (sum by (service_name) (increase(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]))) * 0)) / (sum by (service_name) (increase(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__range])))",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service_name) (increase(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]))) / 1000",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_name) (increase(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]))",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - ((((sum by (service_name) (increase(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__range]))) or (sum by (service_name) (increase(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]))) * 0)) / (sum by (service_name) (increase(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__range])))) / 0.005",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "service_name",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true
      },
      "renameByName": {
       "Value #A": "Availability",
       "Value #B": "Latency p95 (s)",
       "Value #C": "Requests",
       "Value #D": "Error budget left (99.5% SLO)",
       "service_name": "Application"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Availability"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 0.99
          },
          {
           "color": "green",
           "value": 0.995
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Error budget left (99.5% SLO)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 1
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 0.25
          },
          {
           "color": "green",
           "value": 0.5
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Latency p95 (s)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 2
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "timeseries",
   "title": "Error-budget burn rate by application",
   "id": 3,
   "description": "1 = consuming budget exactly at the SLO rate; 14.4 = fast-burn page threshold",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(((sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))) or (sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))) * 0)) / (sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))) / 0.005",
     "legendFormat": "{{service_name}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Latency p95 by application vs 8 s target",
   "id": 4,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))) / 1000",
     "legendFormat": "{{service_name}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 8
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Alerts and change events",
   "id": 5,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Firing alerts",
   "id": 6,
   "description": "From the Prometheus rule groups in use-cases/*/alerts (instant)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true,
       "__name__": true,
       "alertstate": true,
       "Value": true,
       "job": true,
       "instance": true,
       "service_name": true
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity",
       "service": "Service"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "state-timeline",
   "title": "Alert history",
   "id": 7,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "legendFormat": "{{alertname}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "firing",
         "color": "red",
         "index": 0
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       }
      ]
     },
     "custom": {
      "fillOpacity": 70
     }
    },
    "overrides": []
   },
   "options": {
