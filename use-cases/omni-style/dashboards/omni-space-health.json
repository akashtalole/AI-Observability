  {
   "type": "table",
   "title": "Models used by each application (calls)",
   "id": 11,
   "description": "Discovered from span attributes (the same idea as Omni's discovered topology)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
