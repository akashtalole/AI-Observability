    }
   }
  },
  {
   "type": "logs",
   "title": "Change events (scenario changes / deploys written as logs)",
   "id": 8,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 23
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=~\"$service\"} |= \"scenario change\"",
     "queryType": "range",
     "maxLines": 200
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending",
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  },
  {
   "type": "logs",
   "title": "Warnings and errors across the Space",
   "id": 9,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 23
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=~\"$service\"} | detected_level=~\"warn|error\"",
     "queryType": "range",
     "maxLines": 200
