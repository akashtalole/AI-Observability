{
 "uid": "omni-agent-topology",
 "title": "Omni-style \u00b7 Agent Topology",
 "tags": [
  "ai-observability",
  "omni-style"
 ],
 "description": "Which agents hand off to which, which tools each agent uses, and how healthy each edge is.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "id": 1,
   "gridPos": {
    "h": 2,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "Topology is shown as **matrices** (rows = caller, columns = callee/tool) and per-edge health, built from `agent_handoffs_total` and `agent_tool_calls_total`. A true node-link graph needs a node-graph data source; the matrices carry the same information."
   }
  },
  {
   "type": "row",
   "title": "Handoffs and tool usage",
   "id": 2,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 2
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Handoff matrix (from \u2192 to, calls)",
   "id": 3,
   "description": "Darker = more handoffs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (from, to) (increase(agent_handoffs_total{service_name=\"research-agents\"}[$__range]))",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "to",
      "rowField": "from",
      "valueField": "Value",
      "emptyValue": "zero"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true
      },
      "renameByName": {}
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(?!from).*"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "gradient"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "continuous-BlPu"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "table",
   "title": "Tool usage matrix (agent \u00d7 tool, calls)",
   "id": 4,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (agent, tool) (increase(agent_tool_calls_total{service_name=\"research-agents\"}[$__range]))",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "tool",
      "rowField": "agent",
      "valueField": "Value",
      "emptyValue": "zero"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true
      },
      "renameByName": {}
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(?!agent).*"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "gradient"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "continuous-GrYlRd"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "row",
   "title": "Edge health",
   "id": 5,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 11
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Agent \u2192 tool edges: calls and error ratio",
   "id": 6,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (agent, tool) (increase(agent_tool_calls_total{service_name=\"research-agents\"}[$__range]))",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (agent, tool) (increase(agent_tool_calls_total{service_name=\"research-agents\",status=\"error\"}[$__range])) / sum by (agent, tool) (increase(agent_tool_calls_total{service_name=\"research-agents\"}[$__range]))",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true
      },
      "renameByName": {
       "Value #A": "calls",
       "Value #B": "error ratio"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "calls",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "error ratio"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 1
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 0.05
          },
          {
           "color": "red",
           "value": 0.15
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "bargauge",
   "title": "Handoffs by edge",
   "id": 7,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (from, to) (increase(agent_handoffs_total{service_name=\"research-agents\"}[$__range]))",
     "legendFormat": "{{from}} \u2192 {{to}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "max": null,
     "color": {
      "mode": "continuous-BlPu"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   }
  },
  {
   "type": "row",
   "title": "Per-agent activity",
   "id": 8,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 21
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "LLM calls by agent",
   "id": 9,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (agent) (rate(agent_llm_calls_total{service_name=\"research-agents\"}[$__rate_interval]))",
     "legendFormat": "{{agent}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": null,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 30,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "LLM latency p95 by agent",
   "id": 10,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(agent_llm_duration_seconds_bucket{service_name=\"research-agents\"}[$__rate_interval])))",
     "legendFormat": "{{agent}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Spend per hour by agent",
   "id": 11,
