  {
   "type": "table",
   "title": "Handoff-heavy or looping traces",
   "id": 15,
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 36
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ resource.service.name = \"research-agents\" && name = \"invoke_agent supervisor\" && span.app.task.steps > 15 }",
     "limit": 20,
     "tableType": "traces"
    }
   ],
   "options": {
    "showHeader": true
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "traceID"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open in Trace Explorer",
          "url": "/d/omni-trace-explorer?var-traceId=${__value.raw}&${__url_time_range}",
          "targetBlank": false
         }
        ]
       }
      ]
     }
    ]
   }
