   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (agent) (rate(agent_cost_usd_total{service_name=\"research-agents\"}[$__rate_interval])) * 3600",
     "legendFormat": "{{agent}}",
