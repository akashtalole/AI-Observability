    "x": 0,
    "y": 29
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "((sum by (tool) (rate(agent_tool_calls_total{service_name=\"research-agents\",status=\"error\"}[$__rate_interval]))) or vector(0)) / sum by (tool) (rate(agent_tool_calls_total{service_name=\"research-agents\",status!=\"denied\"}[$__rate_interval]))",
     "legendFormat": "{{tool}}",
