{
 "uid": "pipeline-health",
 "title": "Telemetry pipeline health (OTel Collector)",
 "tags": [
  "ai-observability",
  "platform"
 ],
 "description": "Is telemetry itself healthy? Drops here silently bias every other dashboard.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Spans accepted vs refused vs failed to export",
   "id": 1,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_receiver_accepted_spans[$__rate_interval]))",
     "legendFormat": "accepted",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_receiver_refused_spans[$__rate_interval]))",
     "legendFormat": "refused",
     "range": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[$__rate_interval]))",
     "legendFormat": "export failed {{exporter}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": null,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Metric points accepted vs failed",
   "id": 2,
   "description": "",
   "datasource": {
    "type": "prometheus",
