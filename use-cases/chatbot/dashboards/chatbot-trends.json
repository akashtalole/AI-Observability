{
 "uid": "chatbot-trends",
 "title": "Chatbot - Trends (weeks to months)",
 "tags": [
  "ai-observability",
  "chatbot",
  "use-case",
  "trends"
 ],
 "description": "Long-range containment from daily recording rules.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Change events",
    "enable": true,
    "iconColor": "orange",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{service_name=\"support-chatbot\"} |= \"scenario change\"",
    "titleFormat": "change",
    "textFormat": "{{detected_level}}"
   }
  ]
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Containment (daily)",
   "id": 1,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "chat:containment_ratio:ratio_1d",
     "legendFormat": "containment",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Week-over-week containment change",
   "id": 2,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "chat:containment_ratio:ratio_1d / (chat:containment_ratio:ratio_1d offset 7d) - 1",
     "legendFormat": "containment",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": null,
     "max": null,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ],
 "links": [
  {
   "title": "Handbook",
   "type": "link",
   "url": "https://akashtalole.github.io/ai-observability/",
   "targetBlank": true
  }
 ]
}
